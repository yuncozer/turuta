# Copiar a .env.local y completar con los datos del proyecto de Supabase
# (Supabase → Project Settings → API). Sin estas variables la app corre en modo demo.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Consultas antes de invitar a un visitante anónimo a registrarse (opcional, por defecto 5)
NEXT_PUBLIC_SOFT_GATE_VIEWS=5
